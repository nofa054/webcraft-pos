{
    "name": "webcraft/pos-umkm",
    "description": "Webcraft POS - Sistem Kasir dan Manajemen Stok Berbasis Web untuk UMKM",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "phpoffice/phpspreadsheet": "^2.0 || ^1.29",
        "dompdf/dompdf": "^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}

