# ============================================================
# Konfigurasi Lingkungan Aplikasi Webcraft POS
# Salin file ini menjadi .env dan sesuaikan dengan server Anda
# ============================================================

APP_NAME="Webcraft POS"
APP_ENV="production"
APP_DEBUG=false
APP_TIMEZONE="Asia/Jakarta"

# Konfigurasi Database (Pilih driver: mysql atau sqlite)
# Jika menggunakan MySQL/MariaDB di XAMPP/Laragon/Hosting:
DB_DRIVER="mysql"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="webcraft_pos"
DB_USER="root"
DB_PASS=""
DB_CHARSET="utf8mb4"

# Fallback otomatis ke SQLite lokal jika service MySQL belum aktif (true/false)
DB_AUTO_FALLBACK_SQLITE=true

